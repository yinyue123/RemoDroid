// RemoDroid.exe / remodroid-desktopd.exe resources: manifest, icon, version.
// windres -DRD_VERSION_STR=\"0.4\" -DRD_VERSION_NUM=0,4,0,0 -I build/... app.rc app.res
#include <winver.h>

#ifndef RD_VERSION_STR
#define RD_VERSION_STR "0.4"
#define RD_VERSION_NUM 0,4,0,0
#endif

1 24 "app.manifest"
APP ICON "remodroid.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION RD_VERSION_NUM
PRODUCTVERSION RD_VERSION_NUM
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "RemoDroid"
      VALUE "FileDescription", "RemoDroid remote desktop agent"
      VALUE "FileVersion", RD_VERSION_STR
      VALUE "ProductName", "RemoDroid"
      VALUE "ProductVersion", RD_VERSION_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
