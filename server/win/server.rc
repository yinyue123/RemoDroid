// remodroid-server.exe / RemoDroidServer.exe resources: manifest, icon, version.
// windres -DRD_TRAY (RemoDroidServer.exe) -DRD_VERSION_STR=\"0.5\" -DRD_VERSION_NUM=0,5,0,0 -I build/... server.rc out.res
#include <winver.h>

#ifndef RD_VERSION_STR
#define RD_VERSION_STR "0.5"
#define RD_VERSION_NUM 0,5,0,0
#endif

#ifdef RD_TRAY
1 24 "tray.manifest"
#define RD_DESCRIPTION "RemoDroid Server"
#else
1 24 "server.manifest"
#define RD_DESCRIPTION "RemoDroid control server"
#endif
APP ICON "remodroid-server.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION RD_VERSION_NUM
PRODUCTVERSION RD_VERSION_NUM
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "RemoDroid"
      VALUE "FileDescription", RD_DESCRIPTION
      VALUE "FileVersion", RD_VERSION_STR
      VALUE "ProductName", "RemoDroid"
      VALUE "ProductVersion", RD_VERSION_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
