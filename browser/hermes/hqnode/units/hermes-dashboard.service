# Hermes Agent's web dashboard on :9119: public as https://hermes.11100.top through frpc.service, and
# host-only on the container's 9119 mapping (an ssh tunnel). Its login page takes the user and password
# in .env (HERMES_DASHBOARD_BASIC_AUTH_*): set them before frpc.toml is pushed.
[Unit]
Description=Hermes Agent dashboard
After=hermes-gateway.service

[Service]
User=hermes
Group=hermes
Environment=HOME=/var/lib/hermes HERMES_HOME=/data/hermes HERMES_RUNTIME_DIR=/opt/hermes/tools HERMES_WRITE_SAFE_ROOT=/data/hermes PYTHONUNBUFFERED=1
EnvironmentFile=-/data/hermes/.env
ExecStartPre=+/usr/bin/install -d -o hermes -g hermes -m 0700 /data/hermes
ExecStartPre=/usr/local/bin/hermes-seed-home /data/hermes
ExecStart=/usr/local/bin/hermes dashboard --host 0.0.0.0 --port 9119 --no-open
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
