# /data/hermes/.env: Hermes Agent's keys and settings in the OECT's hermes container.
# Copy to browser/hermes/hqnode/hermes.env (git-ignored), fill in, push with deploy.sh.
# KEY=value, one per line, no quotes and no spaces around =: systemd reads this file too.

# Every connection out goes through the host's sing-box inbound mixed-hermes (PLAN.md 4.1, exit: us).
# 192.168.10.1 is pasta's gateway, which is the host's loopback.
HTTPS_PROXY=http://192.168.10.1:1091
HTTP_PROXY=http://192.168.10.1:1091
NO_PROXY=localhost,127.0.0.1,::1
TELEGRAM_PROXY=http://192.168.10.1:1091

# The model provider: one of these (then `hermes model` picks the model).
OPENROUTER_API_KEY=
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
#OPENAI_BASE_URL=

# Telegram: the bot from @BotFather, and who may talk to it (your numeric user id, from @userinfobot).
# Without an allowlist anyone who finds the bot gets a shell in this container.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# The agent's shell runs in this container
TERMINAL_ENV=local

# The dashboard (hermes-dashboard.service), if you enable it
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=

# The OpenAI-compatible API on :8642, off. To use it: true, a key of 32+ random characters, and 8642
# added to the container's ports.
API_SERVER_ENABLED=false
#API_SERVER_KEY=
