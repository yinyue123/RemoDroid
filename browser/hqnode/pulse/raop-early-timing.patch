+/* A receiver may ask the timing port before it answers SETUP, and wait for the reply: a HomePod holds
+ * SETUP for 30 s, then fails it with 500. The sink thread polls the port only once SETUP is done and the
+ * socket is connected, so until then the main loop answers here, to whoever asked. */
+static void early_timing_cb(pa_mainloop_api *a, pa_io_event *e, int fd, pa_io_event_flags_t f, void *userdata) {
+    pa_raop_client *c = userdata;
+    uint8_t packet[64];
+    struct sockaddr_storage from;
+    socklen_t fromlen = sizeof(from);
+    uint32_t *reply = NULL;
+    struct timeval tv;
+    uint64_t rci;
+    size_t size;
+    ssize_t n;
+
+    n = recvfrom(fd, packet, sizeof(packet), 0, (struct sockaddr *) &from, &fromlen);
+    if (n != 32 || packet[0] != 0x80 || (packet[1] ^ 0x80) != PAYLOAD_TIMING_REQUEST)
+        return;
+    if (from.ss_family == AF_INET)
+        c->timing_peer_port = ntohs(((struct sockaddr_in *) &from)->sin_port);
+#ifdef HAVE_IPV6
+    else if (from.ss_family == AF_INET6)
+        c->timing_peer_port = ntohs(((struct sockaddr_in6 *) &from)->sin6_port);
+#endif
+    rci = timeval_to_ntp(pa_rtclock_get(&tv));
+    size = build_udp_timing_packet(c, (const uint32_t *) (packet + sizeof(udp_timing_header)), rci, &reply);
+    if (reply && size > 0) {
+        if (sendto(fd, reply, size, 0, (struct sockaddr *) &from, fromlen) < 0)
+            pa_log_debug("early timing reply: %s", pa_cstrerror(errno));
+        pa_xfree(reply);
+    }
+}
+
+static void early_timing_stop(pa_raop_client *c) {
+    if (c->early_timing) {
+        c->core->mainloop->io_free(c->early_timing);
+        c->early_timing = NULL;
+    }
+}
+
