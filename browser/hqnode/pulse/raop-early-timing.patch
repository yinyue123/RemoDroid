+    pa_io_event *early_timing; /* answers timing between ANNOUNCE and the SETUP reply */
+    uint16_t timing_peer_port; /* where the receiver's timing requests came from */
 
     pa_raop_packet_buffer *pbuf;
 
@@ -697,6 +699,45 @@
