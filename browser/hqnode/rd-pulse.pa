# /etc/rd-browser/rd-pulse.pa: the container's sound server (units/rd-pulse.service). No sound card:
# CloakBrowser plays into a null sink and the desktop agent records its monitor (@DEFAULT_MONITOR@)
# and sends it to the viewer as Opus.
load-module module-null-sink sink_name=browser rate=48000 channels=2 sink_properties=device.description=Browser
set-default-sink browser
# /run/pulse/native, for the members of pulse-access: browser and rdagent
load-module module-native-protocol-unix auth-group=pulse-access auth-anonymous=0
# no listener, no cost: the sink sleeps while nothing plays and nobody records
load-module module-suspend-on-idle
