#!/bin/sh
# The container's own port on the LAN, lan0 (hqnode link <c> --macvlan eth0 --name lan0, and
# CAP_NET_ADMIN), for AirPlay alone. The browser must not see the LAN or the internet through it: its
# traffic keeps going through pasta and the host's kill switch. So lan0's address gets no route in the
# main table. Table 100 holds the LAN, multicast and the gateway, and only two users look there: the
# sound server (user pulse, which streams to the speakers) and avahi (which finds them). No rule sends
# packets there by their source address, so another program can't bind to the address and get out.
# No IPv6 on lan0.
#
# The address, first found first used:
#   - hqnode's: the container's Network card (or hqnode link --address --gateway) sets it over netlink
#     at start, with the subnet and gateway in a table of the link's own; rd-lan only narrows who uses it
#   - lan_address (192.168.10.44/24) and lan_gateway (192.168.10.2) in /data/browser.conf
#   - DHCP
# Without a gateway, table 100 ends in an unreachable default.
#
#   rd-lan             the service (rd-lan.service): set up the port, then DHCP in the foreground if needed
#   rd-lan EVENT       udhcpc's script: bound, renew, deconfig
set -u
IF=lan0 T=100

conf() { sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*\([^[:space:]]*\).*/\1/p" /data/browser.conf 2>/dev/null | tail -n 1; }

agent_route() {
	# Only the trusted desktop agent's UDP (ICE/media) uses the LAN. Its
	# signalling and every browser connection retain the main-table route.
	while ip rule del pref 102 2>/dev/null; do :; done
	if [ "$(conf lan_webrtc)" = 1 ]; then
		id=$(id -u rdagent) && ip rule add uidrange "$id-$id" ipproto udp lookup "$1" pref 102
	fi
}

addr_set() { # address/prefix
	ip -4 -o addr show dev "$IF" | grep -q " $1 " && return 0
	ip -4 addr flush dev "$IF"
	ip addr add "$1" dev "$IF" noprefixroute
}

table_set() { # address/prefix gateway
	eval "$(busybox ipcalc -n -p "$1")"
	ip -4 route flush table $T
	ip route add "$NETWORK/$PREFIX" dev "$IF" src "${1%/*}" table $T
	ip route add 224.0.0.0/4 dev "$IF" table $T
	if [ -n "$2" ]; then
		ip route add default via "$2" dev "$IF" src "${1%/*}" table $T
	else
		ip route add unreachable default table $T
	fi
	echo "rd-lan: $IF $1, gateway ${2:-none}"
	agent_route "$T"
}

case "${1:-}" in
deconfig)
	ip -4 addr flush dev "$IF"
	ip -4 route flush table $T
	exit 0
	;;
bound|renew)
	addr_set "$ip/$mask" && table_set "$ip/$mask" "$(conf lan_gateway)"
	exit 0
	;;
"") ;;
*) exit 0 ;;
esac

# hqnode moves the port in a moment after the container starts: systemd may be here first
i=0
while [ ! -e /sys/class/net/$IF ] && [ $i -lt 60 ]; do sleep 0.5; i=$((i + 1)); done
[ -e /sys/class/net/$IF ] || { echo "rd-lan: no $IF: no AirPlay"; exit 0; }
echo 1 > /proc/sys/net/ipv6/conf/$IF/disable_ipv6
# a speaker's packets arrive on lan0 while the main table reaches the LAN through tap0: no strict check
echo 0 > /proc/sys/net/ipv4/conf/$IF/rp_filter
[ "$(cat /proc/sys/net/ipv4/conf/all/rp_filter)" != 1 ] || echo 2 > /proc/sys/net/ipv4/conf/all/rp_filter
ip link set "$IF" up
while ip rule del pref 100 2>/dev/null; do :; done # an older rd-lan's "from <address>" rule
while ip rule del pref 101 2>/dev/null; do :; done
for u in pulse avahi; do
	id=$(id -u $u) && ip rule add uidrange "$id-$id" lookup $T pref 101
done

# hqnode gave lan0 its address (its Network card, or hqnode link --address --gateway): it put the
# subnet and gateway in a table of the link's own, with a rule sending there what leaves from the
# address. Keep the table, swap the rule for the users above: the browser could bind to the address.
have=$(ip -4 -o addr show dev "$IF" | awk '{print $4}' | head -n 1)
a=${have%/*}
t=
[ -z "$have" ] || t=$(ip -4 rule | sed -n "s/^[0-9]*:[[:space:]]*from $a lookup \([0-9a-z]*\).*/\1/p" | head -n 1)
# an rd-lan restarted after taking hqnode's address over: the rule is gone, /run remembers the table
[ -n "$t" ] || [ -z "$have" ] || t=$(sed -n "s|^$have ||p" /run/rd-lan.hqnode 2>/dev/null)
if [ -n "$t" ]; then
	while ip rule del from "$a" lookup "$t" 2>/dev/null; do :; done
	while ip rule del pref 101 2>/dev/null; do :; done
	for u in pulse avahi; do
		id=$(id -u $u) && ip rule add uidrange "$id-$id" lookup "$t" pref 101
	done
	echo "$have $t" > /run/rd-lan.hqnode
	agent_route "$t"
	echo "rd-lan: $IF $have, from hqnode, table $t: for the sound server and avahi only"
	exit 0
fi

addr=$(conf lan_address)
if [ -n "$addr" ]; then
	case "$addr" in */*) ;; *) addr=$addr/24 ;; esac
	addr_set "$addr" && table_set "$addr" "$(conf lan_gateway)"
	exit
fi
exec busybox udhcpc -i "$IF" -f -R -s "$0"
