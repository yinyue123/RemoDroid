# /data/browser.conf: the remote browser's settings, read by rd-shell (and screen= by rd-xorg).
# key = value; a line starting with # is a comment. After a change:
#   systemctl restart rd-shell             (screen: systemctl restart rd-xorg rd-shell)

# The SOCKS5 proxy every page, its DNS and its WebRTC go through. Without one the browser isn't started,
# since a page would see this machine's own address (allow_direct = 1 starts it anyway).
# A proxy that needs a password: run a local forwarder (gost, microsocks) and point this at 127.0.0.1.
proxy = socks5://203.0.113.10:1080
webrtc_ip = auto

# Match the proxy's exit: the page compares these with the address it sees.
timezone = America/New_York
lang = en-US

# The screen: the iPhone 14 Plus's, below its status bar. light = 880x1808 at 2x (the OECT's),
# small = 784x1616 at 2x, native = 1280x2624 at 3x (too heavy for the OECT).
screen = light

# The users, switched from the bar's menu (User: …). Each has a directory of their own in data:
# profile/ (cookies, site data), seed (the fingerprint), tabs (open again on the next start), history
# and favourites. The browser is closed completely before another user's starts. "New identity" gives
# the user in use a new seed and an empty profile; their history and favourites stay.
users = Alice Bob Charlie David Eve Frank
data = /data/users
# The disk cache, everyone's, on tmpfs: emptied whenever the user changes.
cache = /tmp/rd-cache

# Any setting above or below can be given for one user: key.Name = value, e.g. a proxy, timezone and
# language for Bob, so his exit address isn't Alice's. Add each proxy to the host's kill switch too
# (/etc/rd-killswitch.conf).
#   proxy.Bob = socks5://198.51.100.20:1080
#   timezone.Bob = Europe/Berlin
#   lang.Bob = de-DE

home = https://www.google.com/
search = https://duckduckgo.com/?q=%s

# The browser, and anything to add to its command line (space-separated).
browser = /opt/cloakbrowser/chrome
# The system CloakBrowser presents (--fingerprint-platform): windows (its advice on a Linux machine: the
# most common one, the hardest to single out), macos, or linux.
platform = windows
args =
renderer_process_limit = 2
# A URL opened from the bar replaces the tab (1), or opens beside it (0).
one_tab = 1
