# The RemoDroid desktop agent: the screen (Rockchip MPP H.265) and the browser's sound (rd-pipewire) to
# the iPhone, touches and keys back.
# Paired once with `remodroid-desktopd -c /data/remodroid/desktop.ini pair --panel … --code …`; the
# pairing is on /data, so a reinstall keeps it.
[Unit]
Description=RemoDroid desktop agent for the remote browser
After=rd-xorg.service rd-video.service rd-pipewire-pulse.service network-online.target
Wants=network-online.target rd-pipewire-pulse.service
PartOf=rd-xorg.service

[Service]
User=rdagent
Group=rdagent
SupplementaryGroups=rdx video
Environment=DISPLAY=:0 XAUTHORITY=/run/rd-xorg.auth HOME=/var/lib/rdagent PULSE_SERVER=unix:/run/pulse/native
# the browser's own sink, whichever is the default: what an AirPlay speaker plays, the viewer doesn't
Environment=PULSE_SOURCE=browser.monitor
ExecStartPre=/bin/sh -c 'for i in $(seq 50); do [ -S /tmp/.X11-unix/X0 ] && exit 0; sleep 0.1; done; exit 1'
# the pairing on /data, owned by number: an image whose rdagent has another id would lose it
# /data outlives the image: a desktop.ini from before Page mode gets its [mirror] section (rd-mirror's socket)
ExecStartPre=+/bin/sh -c '[ -f /data/remodroid/desktop.ini ] && ! grep -q "^\\[mirror\\]" /data/remodroid/desktop.ini && printf "\\n[mirror]\\nsocket = /run/rd-mirror/sock\\n" >> /data/remodroid/desktop.ini; exit 0'
ExecStartPre=+/usr/bin/chown -R rdagent:rdagent /data/remodroid
ExecStart=/usr/bin/remodroid-desktopd -c /data/remodroid/desktop.ini
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
