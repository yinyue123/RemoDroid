# The controller bar, window manager and CloakBrowser supervisor (browser/rd-shell).
[Unit]
Description=Remote browser: controller bar and CloakBrowser
After=rd-xorg.service rd-pipewire-pulse.service
Wants=rd-pipewire-pulse.service
Requires=rd-xorg.service
PartOf=rd-xorg.service

[Service]
User=browser
Group=browser
SupplementaryGroups=rdx
Environment=DISPLAY=:0 XAUTHORITY=/run/rd-xorg.auth HOME=/var/lib/browser PULSE_SERVER=unix:/run/pulse/native
# Xorg's socket is there a moment after it starts
ExecStartPre=/bin/sh -c 'for i in $(seq 50); do [ -S /tmp/.X11-unix/X0 ] && exit 0; sleep 0.1; done; exit 1'
# the users' profiles, tabs, history and favourites: /data is root's, so root makes the directory
ExecStartPre=+/usr/bin/install -d -o browser -g browser -m 0777 /data/users
# /data outlives the image, and its files are owned by number: an image whose browser user has another
# id would find every profile and favourite unreadable (2026-11-01). Hand them to this one.
ExecStartPre=+/usr/bin/chown -R browser:browser /data/users
# and open to everyone besides, whatever the owner: the favourites were lost once to an owner mix-up
# (rd-shell read nothing, then saved that). New files and directories are open too (UMask).
ExecStartPre=+/usr/bin/chmod -R a+rwX /data/users
UMask=0000
# /run/rd-shell/sock: rd-mirror's way to the browser's DevTools pipe and to the bar (Page mode). This user only.
RuntimeDirectory=rd-shell
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/rd-shell -c /data/browser.conf
Restart=always
RestartSec=2
# systemd's default is 15% of the container's pids.max (76 of hqnode's 512): Chromium's zygote then
# cannot fork a renderer and every page stays blank. The container's own limit still applies.
TasksMax=infinity

[Install]
WantedBy=multi-user.target
