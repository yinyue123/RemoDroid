# systemd unit for the RemoDroid control server (installed by the deb/rpm packages).
#   systemctl enable --now remodroid-server, then open http://<server>:5580/ (setup wizard;
#   it writes /etc/remodroid/server.ini, hence ReadWritePaths)
[Unit]
Description=RemoDroid control server
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/remodroid-server -c /etc/remodroid/server.ini
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/etc/remodroid
ReadOnlyPaths=/usr/share/remodroid
StateDirectory=remodroid
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
