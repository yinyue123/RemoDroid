; /etc/remodroid/server.ini — the RemoDroid server (plan §4.7).
; Easiest: start the server and open http://<this server>:5580/ — the setup wizard
; (code in /var/lib/remodroid/setup-token) writes this file for you, and the Routers
; page adds routers. Editing by hand works too; reload with: systemctl reload remodroid-server

[http]
listen = 0.0.0.0:5580              ; the wizard moves this to the port you choose
web_root = /usr/share/remodroid/web
allowed_origins =                  ; extra allowed Origins for /ws/viewer, comma separated

[tls]
; HTTPS. Simplest: set [acme] domains below and leave this section alone; HTTPS then
; listens on 0.0.0.0:443 with a free, automatically renewed certificate.
;listen = 0.0.0.0:443
;cert = /etc/remodroid/fullchain.pem  ; your own certificate chain instead of ACME (PEM)
;key = /etc/remodroid/privkey.pem     ; reloaded on SIGHUP (e.g. after certbot renews)
plain_http = redirect              ; redirect: [http] only answers ACME challenges and redirects to
                                   ; HTTPS, so agents must use wss://  |  allow: plain HTTP keeps working

[acme]
; Automatic certificates (Let's Encrypt by default). Needs: the domain's DNS pointing at
; this server, and TCP 80 open to the internet (challenges arrive on [http] listen).
; Setting domains means you accept the CA's terms of service.
domains =                          ; e.g. remodroid.example.com (comma-separated; no wildcards)
email =                            ; optional contact address for the CA
;directory = https://acme-v02.api.letsencrypt.org/directory
;            staging (for trying things out): https://acme-staging-v02.api.letsencrypt.org/directory
;dir = /var/lib/remodroid/acme      ; account key, certificate and its key
;ca_file =                          ; CAs trusted for the ACME server; empty = the system bundle
;profile =                          ; CA certificate profile, e.g. shortlived (Let's Encrypt)

[auth]
session_days = 30                  ; how long a login stays valid
cookie_name = rd_session
max_failed_logins = 5              ; per IP, then a temporary lockout
lockout_minutes = 15               ; lockout_seconds overrides this when set (e.g. for testing)
;lockout_seconds = 900

[users]
; username = bcrypt hash   (made by the setup wizard, or: remodroid-server hashpw)
; No users = setup mode: only the wizard is served, unlocked by the setup code.

[devices]
; device id = bcrypt hash of its secret   (added by `remodroid enroll` from the Routers page)

[device_names]

[turn]
; Built-in STUN + TURN relay (no coturn needed); the setup wizard fills this in.
listen =                           ; e.g. 0.0.0.0:3478 (UDP); empty = off
public_ip =                        ; the address phones and iPhones can reach (EC2 private IPs are NATed)
relay_min_port = 49152             ; open this UDP range plus the listen port in the firewall
relay_max_port = 49252
realm = remodroid
max_allocations = 32
urls =                             ; handed to both sides, e.g. stun:HOST:3478, turn:HOST:3478?transport=udp
shared_secret =                    ; signs the short-lived TURN credentials (the wizard makes one)
credential_ttl_minutes = 60

[ice]
; More STUN/TURN servers for both sides: "url [username credential]", comma-separated
extra =

[keepalive]
ping_seconds = 20
timeout_seconds = 60
heartbeat_seconds = 30

[log]
level = info
