#!/bin/sh /etc/rc.common
# OpenWrt procd service for the RemoDroid control server (installed by the ipk).
START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/remodroid-server
CONF=/etc/remodroid/server.ini

start_service() {
    procd_open_instance
    procd_set_param command "$PROG" -c "$CONF"
    procd_set_param respawn 3600 5 0
    procd_set_param stderr 1
    procd_set_param file "$CONF"
    procd_close_instance
}

reload_service() {
    procd_send_signal remodroid-server '*' HUP
}
